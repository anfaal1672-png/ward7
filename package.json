{
  "name": "ward7",
  "private": true,
  "scripts": {
    "build": "node game/build.mjs",
    "check": "node game/build.mjs --check && node .tools/extract.js ward7.html /tmp/ward7-check.js && node --check /tmp/ward7-check.js",
    "selftest": "node .tools/stq.js \"$PWD/ward7.html\"",
    "lint": "node .tools/extract.js ward7.html .check/ward7.js && eslint --max-warnings 0 .check/ward7.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "10.1.0",
    "globals": "17.12.0",
    "jsdom": "^26.1.0",
    "playwright": "1.56.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
